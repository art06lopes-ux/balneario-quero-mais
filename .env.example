# Copie para .env.local e preencha com os valores do projeto Supabase
# (Project Settings > API). Nenhum valor real entra neste arquivo.

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (publishable). É pública por natureza: a proteção vem da RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origem do site, sem barra final. Ex.: http://localhost:3000 em desenvolvimento,
# https://balneario.com.br em produção. Usada no Open Graph e no sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ATENÇÃO: a service_role NÃO entra aqui. Ela só é usada uma vez, pelo
# script de criação do administrador, via variável de ambiente temporária.
